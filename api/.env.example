NODE_ENV=development
PORT=3000

# Banco local do docker-compose.yml da raiz (porta 5433)
DATABASE_URL="postgresql://rede:rede_dev@localhost:5433/rede_casinha?schema=public"
# Usado só pelos testes e2e (npm run test:e2e)
TEST_DATABASE_URL="postgresql://rede:rede_dev@localhost:5433/rede_casinha_test?schema=public"

# Opcional: centro e raio das casinhas de exemplo do seed (padrão: Praça da Sé, SP)
# SEED_LAT=-23.5505
# SEED_LNG=-46.6333
# SEED_RAIO_M=3000

# Login com Google: ID do cliente OAuth "Aplicativo da Web" (é o audience do ID token; não é segredo)
GOOGLE_WEB_CLIENT_ID=979435269036-a1j81bqpbfjkank13jftksb9e4a5sbi0.apps.googleusercontent.com

# Segredos (gere com: openssl rand -base64 48). Nunca reutilize os de desenvolvimento em produção.
JWT_SEGREDO=troque-por-um-valor-aleatorio-de-pelo-menos-32-caracteres
HMAC_SEGREDO=troque-por-outro-valor-aleatorio-de-pelo-menos-32-caracteres

# E-mail: console (só loga), resend (envia de verdade; exige RESEND_API_KEY)
EMAIL_DRIVER=console
# RESEND_API_KEY=
# EMAIL_REMETENTE="Rede Casinha <onboarding@resend.dev>"

# true atrás do Caddy em produção
CONFIAR_PROXY=false

# Fotos: disco (pasta local, padrão), s3 (AWS S3 ou compatível) ou memoria (só testes)
ARMAZENAMENTO_DRIVER=disco
# ARMAZENAMENTO_PASTA=./armazenamento
# Com ARMAZENAMENTO_DRIVER=s3 (bucket privado; o app só vê as fotos pela API):
# S3_BUCKET=rede-casinha-bucket
# AWS_REGION=sa-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=   # só para compatíveis com S3 (ex.: Cloudflare R2)
