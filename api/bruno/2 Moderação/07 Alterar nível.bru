meta {
  name: Alterar nível do usuário
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/admin/usuarios/{{usuarioId}}/nivel
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nivel": "verificado",
    "motivo": ""
  }
}
docs {
  nivel: colaborador | verificado | moderador | admin. Moderador promove a verificado; moderador e admin só um admin cria. Critérios em docs/moderacao.md.
}
